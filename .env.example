# Local fictional-document demo: see docs/LOCAL_DEMO.md.
# Keep credentials in the process environment or a locally ignored .env, never in Git.
# Fresh clone: add .env to .git/info/exclude before storing credentials (see guide).
# Run npm run demo:check to validate local syntax without API calls.
# The demo uses only OPENAI_API_KEY and optional DEMO_* overrides.
# Omit model overrides to use defaults; blank/whitespace values are rejected.
OPENAI_API_KEY=
# Default: GPT-5.6 Terra. Set gpt-5.6-luna for the alternative generation model.
# Both use reasoning effort none; see guide for current verification evidence.
DEMO_MODEL=gpt-5.6-terra
DEMO_EMBED_MODEL=text-embedding-3-small

# Placeholder reference for the original, unintegrated component examples.
# Do not connect them to private documents: ingestion dry-run and cloud sharing
# need fixes first. The local demo does not use the settings below.
EMBED_MODEL=text-embedding-3-large
PINECONE_API_KEY=
PINECONE_INDEX_NAME=fictional-demo-placeholder
PINECONE_NAMESPACE=fictional-demo-placeholder

REDIS_URL=redis://localhost:6379
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=fictional_demo_placeholder
DB_USERNAME=demo_placeholder
DB_PASSWORD=
# Existing TLS verification behavior needs review before remote DB use.
DB_SSL=false

# Cloud integration is optional architectural material, not a demo requirement.
DROPBOX_ACCESS_TOKEN=
