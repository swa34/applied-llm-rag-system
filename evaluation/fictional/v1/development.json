          }
        },
        {
          "id": "travel-follow-up",
          "question": "Does that change for part-time staff?",
          "expected": {
            "status": "answered",
            "queryPattern": "travel|trip",
            "facts": [{ "sourceId": "src.travel.part-time", "patterns": ["part.time", "supervisor", "same|unchanged|does not change|no change"] }]
          }
        },
        {
          "id": "topic-switch",
          "question": "How do I reset my password?",
          "expected": {
            "status": "answered",
            "queryPattern": "password",
            "onlyDocumentIds": ["doc.password-reset"],
            "facts": [{ "sourceId": "src.password-reset.self-service", "patterns": ["reset", "password"] }]
          }
        }
      ]
    },
